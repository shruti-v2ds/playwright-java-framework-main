<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Playwright Cucumber Test Suite" parallel="methods" thread-count="1">

    <listeners>
        <listener class-name="framework.utils.TestListener"/>
    </listeners>

    <test name="Cucumber Tests">
        <classes>
            <class name="runners.TestRunner"/>
        </classes>
    </test>

</suite>
